NEXT_PUBLIC_API_BASE_URL=https://bot.example.com
APP_PUBLIC_BASE_URL=https://bot.example.com

POSTGRES_DB=customer_service_bot
POSTGRES_USER=customer_service_bot
POSTGRES_PASSWORD=change-this-db-password

APP_NAME=Telegram Customer Service Bot API
APP_ENV=production
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_REDIS_URL=redis://redis:6379/0
# Keep both values true for the first successful bootstrap, then switch both to false.
APP_AUTO_CREATE_SCHEMA=true
APP_BOOTSTRAP_DEMO_DATA=true
APP_DEFAULT_TENANT_NAME=Default Tenant
APP_DEFAULT_BOT_NAME=Support Bot
APP_DEFAULT_SUPPORT_GROUP_CHAT_ID=-1001234567890
APP_DEFAULT_ADMIN_EMAIL=admin@example.com
APP_DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_DEFAULT_SUPER_ADMIN_EMAIL=superadmin@example.com
APP_DEFAULT_SUPER_ADMIN_PASSWORD=replace-with-a-strong-super-admin-password
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_OPENAI_API_KEY=replace-with-your-openai-compatible-api-key
APP_ROUTER_MODEL=gpt-4o-mini
APP_GENERATOR_MODEL=gpt-4.1-mini
APP_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Cloudflare R2 image storage for FAQ/knowledge-page pictures.
APP_R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
APP_R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
APP_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
APP_R2_BUCKET=customer-service-ai-bot-media
APP_R2_PUBLIC_BASE_URL=https://media.example.com
APP_R2_MAX_IMAGE_BYTES=5242880
