APP_NAME=Telegram Customer Service Bot API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_service_bot
APP_REDIS_URL=redis://localhost:6379/0
APP_AUTO_CREATE_SCHEMA=true
APP_BOOTSTRAP_DEMO_DATA=true
APP_DEFAULT_TENANT_NAME=Default Tenant
APP_DEFAULT_BOT_NAME=Support Bot
APP_DEFAULT_SUPPORT_GROUP_CHAT_ID=-1001234567890
APP_DEFAULT_ADMIN_EMAIL=admin@example.com
APP_DEFAULT_ADMIN_PASSWORD=ChangeMe123!
APP_DEFAULT_SUPER_ADMIN_EMAIL=superadmin@example.com
APP_DEFAULT_SUPER_ADMIN_PASSWORD=ChangeMe123!
APP_OPENAI_BASE_URL=https://api.openai.com/v1
APP_OPENAI_API_KEY=
APP_ROUTER_MODEL=gpt-4o-mini
APP_GENERATOR_MODEL=gpt-4.1-mini
APP_WEBHOOK_SECRET=
APP_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
